{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"]
	// $app/tsconfig is generated by `svelte-kit sync` into node_modules/$app/tsconfig.json
	// and supplies the essential/recommended options (verbatimModuleSyntax, isolatedModules,
	// moduleResolution, allowJs, checkJs, noEmit, ...). `#lib` comes from the `imports`
	// field in package.json (subpath imports), not from tsconfig paths.
	// See https://svelte.dev/docs/kit/configuration#typescript
}
